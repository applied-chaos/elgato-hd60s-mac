#ifndef HD60SDriver_h
#define HD60SDriver_h

#include <DriverKit/IOService.iig>
#include <DriverKit/IOTimerDispatchSource.iig>
#include <DriverKit/IOMemoryDescriptor.iig>
#include <USBDriverKit/IOUSBHostPipe.iig>
#include <AudioDriverKit/IOUserAudioDriver.iig>

class HD60SDriver : public IOUserAudioDriver
{
public:
    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t NewUserClient(uint32_t type, IOUserClient **userClient) override;
    virtual kern_return_t StartDevice(IOUserAudioObjectID object_id, IOUserAudioStartStopFlags flags) override LOCALONLY;
    virtual kern_return_t StopDevice(IOUserAudioObjectID object_id, IOUserAudioStartStopFlags flags) override LOCALONLY;
    kern_return_t CopyFrameRing(IOMemoryDescriptor **memory) LOCALONLY;
    void BringUp() LOCALONLY;
    void TearDown(bool deviceGone) LOCALONLY;
    int Control(int in, uint8_t req, uint16_t val, uint16_t idx, uint8_t *buf, uint16_t len) LOCALONLY;
    void Frame(const uint8_t *frame, int width, int height, int interlaced) LOCALONLY;
    void Audio(const uint8_t *pcm, size_t len) LOCALONLY;
    void Deliver(uint64_t host) LOCALONLY;
    virtual void ZeroTimestampOccurred(OSAction *action TARGET, uint64_t time) TYPE(IOTimerDispatchSource::TimerOccurred) QUEUENAME(USB);
    virtual void PolicyOccurred(OSAction *action TARGET, uint64_t time) TYPE(IOTimerDispatchSource::TimerOccurred) QUEUENAME(USB);
    virtual void BulkDone(OSAction *action TARGET, IOReturn status, uint32_t actualByteCount, uint64_t completionTimestamp)
        TYPE(IOUSBHostPipe::CompleteAsyncIO) QUEUENAME(USB);
};

#endif
