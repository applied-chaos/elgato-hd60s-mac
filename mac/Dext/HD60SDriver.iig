#ifndef HD60SDriver_h
#define HD60SDriver_h

#include <DriverKit/IOService.iig>
#include <DriverKit/IOTimerDispatchSource.iig>
#include <AudioDriverKit/IOUserAudioDriver.iig>

class HD60SDriver : public IOUserAudioDriver
{
public:
    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t StartDevice(IOUserAudioObjectID object_id, IOUserAudioStartStopFlags flags) override LOCALONLY;
    virtual kern_return_t StopDevice(IOUserAudioObjectID object_id, IOUserAudioStartStopFlags flags) override LOCALONLY;
    virtual void ZeroTimestampOccurred(OSAction *action TARGET, uint64_t time) TYPE(IOTimerDispatchSource::TimerOccurred);
};

#endif
